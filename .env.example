# Локально: файловая БД. В проде (Vercel) — URL и токен Turso.
DATABASE_URL=file:local.db
# DATABASE_URL=libsql://<db>-<org>.turso.io
# Интеграция Turso в Vercel задаёт TURSO_DATABASE_URL / TURSO_AUTH_TOKEN — они тоже подхватываются.
DATABASE_AUTH_TOKEN=

# Телеметрия партий (/api/telemetry): в dev включена по умолчанию, в проде - только при TELEMETRY_ENABLED=1.
# TELEMETRY_ENABLED=1
